# Supabase (프로젝트 설정 > API에서 복사)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 아이디 로그인용 내부 이메일 도메인 (username → {username}@civilwar.local)
NEXT_PUBLIC_INTERNAL_EMAIL_DOMAIN=civilwar.local

# Discord 봇 — Developer Portal > General Information 의 Public Key (hex 64자)
# 인터랙션 서명검증용. 서버 전용(NEXT_PUBLIC_ 아님). Vercel env에도 동일하게 등록.
DISCORD_PUBLIC_KEY=your-discord-application-public-key

# Discord 봇 토큰 (Bot 탭) — REST 호출(메시지·반응)용. 서버 전용. Vercel env에도 등록.
DISCORD_BOT_TOKEN=your-discord-bot-token

# Discord Application ID (General Information) — 슬래시 커맨드 등록 대상. 비밀 아님.
DISCORD_APPLICATION_ID=your-discord-application-id

# 내전 디스코드 서버 ID (서버 우클릭 → 서버 ID 복사) — 길드 커맨드 즉시 등록용.
DISCORD_GUILD_ID=your-discord-guild-id
