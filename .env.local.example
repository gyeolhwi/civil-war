# Supabase (프로젝트 설정 > API에서 복사)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 아이디 로그인용 내부 이메일 도메인 (username → {username}@civilwar.local)
NEXT_PUBLIC_INTERNAL_EMAIL_DOMAIN=civilwar.local

# Discord 봇 — Developer Portal > General Information 의 Public Key (hex 64자)
# 인터랙션 서명검증용. 서버 전용(NEXT_PUBLIC_ 아님). Vercel env에도 동일하게 등록.
DISCORD_PUBLIC_KEY=your-discord-application-public-key
