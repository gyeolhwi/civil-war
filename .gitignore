.vscode/
.idea/
.cursor/
*.swp
*.swo
*~

# OMC (oh-my-claudecode)
.omc/
# .claude/

# Playwright / MCP
playwright-mcp/
playwright-report/
test-results/
.playwright/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
dist/

# debug / logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (예시 템플릿만 추적)
.env
.env.local
.env.*.local
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# misc
*.pem

# Generated docs (md에서 재생성 가능)
docs/*.pdf

# Temp
*.tmp
tmp/

# 로컬 참고자료 (외부 프로젝트 클론 — 저장소에 포함하지 않는다)
refs/
