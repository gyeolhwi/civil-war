# 기본: 텍스트 파일은 자동 감지 후 LF로 정규화
* text=auto eol=lf

# 명시적으로 LF를 강제할 파일
*.sh    text eol=lf
*.bash  text eol=lf

# Windows 전용 스크립트는 CRLF 유지
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 바이너리 파일 (자동 감지 오인 방지)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
